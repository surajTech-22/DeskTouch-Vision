<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Only the DEBUG build contains the emulator input acceptance target. -->
    <activity android:name=".InputProbeActivity"
      android:exported="true" android:launchMode="singleTop"
      android:windowSoftInputMode="adjustResize" />
    <!-- Debug-only separate process, no second APK and no production changes. -->
    <activity android:name=".ExternalEditorProbeActivity"
      android:process=":editor-probe" android:exported="true"
      android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
    <receiver android:name=".DebugRemoteInputReceiver" android:exported="true">
      <intent-filter>
        <action android:name="com.desktouch.vision.DEBUG_SEND_INPUT" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
