<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DeskTouch.DeviceShare</AssemblyName>
    <Version>0.3.2-preview</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- Reuse the SAME official GitHub release updater in the visible UI. -->
    <Compile Include="../UpdateClient.cs" Link="UpdateClient.cs" />
    <None Include="ALLOW_PRIVATE_LAN.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
